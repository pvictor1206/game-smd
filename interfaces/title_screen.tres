code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec2 speed;



void vertex() {
// Input:3
	float n_out3p0 = TIME;


// Vector2Parameter:5
	vec2 n_out5p0 = speed;


// VectorOp:4
	vec2 n_out4p0 = vec2(n_out3p0) * n_out5p0;


// UVFunc:2
	vec2 n_in2p1 = vec2(1.00000, 1.00000);
	vec2 n_out2p0 = n_out4p0 * n_in2p1 + UV;


// Output:0
	UV = n_out2p0;


}
